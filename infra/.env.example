# Copy to infra/.env on the server. Never commit the real file.
NODE_ENV=production
PORT=3001

# Postgres (compose wires DATABASE_URL from this)
POSTGRES_PASSWORD=generate-a-long-random-password

# 64 hex chars: openssl rand -hex 32
MESSAGE_ENC_KEY=

# 32+ chars: openssl rand -base64 48
JWT_SECRET=

# Comma-separated exact origins
CORS_ORIGINS=https://dawitzelleke.vercel.app

# Contact relay (resend.com free tier) — optional but recommended
RESEND_API_KEY=
CONTACT_TO_EMAIL=Dawit.Zelleke13@gmail.com

# Cloudflare Turnstile — optional
TURNSTILE_SECRET=
