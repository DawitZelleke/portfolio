# The site address comes from API_DOMAIN in infra/.env:
#   production: api.yourdomain.com   → Caddy gets and renews Let's Encrypt certs
#   staging:    http://192.168.122.35 → plain HTTP inside the homelab
{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:3001
}
